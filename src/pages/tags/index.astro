---
import { listPosts } from '../../lib/posts';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await listPosts();
const counts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);

// 按一级标签分组展示，保持知识库原有的层级感
const groups = new Map<string, { tag: string; n: number }[]>();
for (const [tag, n] of counts) {
  const top = tag.split('/')[0];
  if (!groups.has(top)) groups.set(top, []);
  groups.get(top)!.push({ tag, n });
}
const ordered = [...groups.entries()].sort((a, b) => a[0].localeCompare(b[0], 'zh'));
---
<Base title="标签" description="全部标签">
  <div class="wrap" style="padding-top: 48px; padding-bottom: 72px;">
    <h1 style="font-family: var(--serif); font-size: 26px; font-weight: 600; margin: 0 0 28px;">标签</h1>
    {ordered.map(([top, items]) => (
      <section style="margin-bottom: 30px;">
        <h2 class="eyebrow">{top}</h2>
        <div style="display: flex; flex-wrap: wrap; gap: 7px;">
          {items.sort((a, b) => b.n - a.n).map((i) => (
            <a href={`${base}/tags/${encodeURIComponent(i.tag)}`}
               style="font-size: 13px; color: var(--fg); border: 1px solid var(--border); padding: 4px 10px; border-radius: 3px;">
              {i.tag.split('/').slice(1).join('/') || i.tag}
              <span class="num" style="color: var(--muted); margin-left: 6px; font-size: 11.5px;">{i.n}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
