---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.date - a.data.date),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={tag} description={`标签 ${tag} 下的文章`}>
  <div class="wrap" style="padding-top: 48px; padding-bottom: 72px;">
    <p class="eyebrow" style="margin-bottom: 4px;">标签</p>
    <h1 style="font-family: var(--serif); font-size: 24px; font-weight: 600; margin: 0 0 24px; word-break: break-word;">{tag}</h1>
    {posts.map((p) => <PostCard post={p} />)}
  </div>
</Base>
