---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: `${base}/archive`, label: '归档' },
  { href: `${base}/tags`, label: '标签' },
  { href: `${base}/tools`, label: '工具与效率' },
  { href: `${base}/about`, label: '关于' },
];
---
<header style="border-bottom: 1px solid var(--border); background: var(--bg); position: sticky; top: 0; z-index: 10;">
  <div class="wrap" style="display: flex; align-items: baseline; gap: 32px; height: 68px;">
    <a href={base || '/'} style="font-family: var(--serif); font-size: 19px; font-weight: 600; color: var(--fg); letter-spacing: -0.01em;">表征笔记</a>
    <nav style="display: flex; gap: 22px; font-size: 14px; margin-left: auto;" aria-label="主导航">
      {nav.map((n) => <a href={n.href} style="color: var(--muted);">{n.label}</a>)}
    </nav>
  </div>
</header>
