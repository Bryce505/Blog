---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer style="border-top: 1px solid var(--border); margin-top: auto;">
  <div class="wrap" style="padding: 26px 40px; display: flex; gap: 20px; flex-wrap: wrap; font-size: 13px; color: var(--muted);">
    <span>内容来自个人 Obsidian 知识库，由流水线定时整理发布</span>
    <a href={`${base}/rss.xml`} style="margin-left: auto;">RSS</a>
  </div>
</footer>
