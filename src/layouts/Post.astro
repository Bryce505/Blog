---
import Base from './Base.astro';

interface Props { entry: any; headings: any[]; related: any[]; series?: any; }
const { entry, headings, related, series } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const d = entry.data.date;
const date = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const count = entry.data.sourceNotes?.length ?? 0;
// 目录设上限：源笔记标题多，实测有文章目录比正文还长。
// 超过 14 条就只留二级标题；仍超就截断，宁可少列也不要一屏滚不完的侧栏。
const all = headings.filter((h) => h.depth === 2 || h.depth === 3);
const toc = (all.length > 14 ? all.filter((h) => h.depth === 2) : all).slice(0, 20);
const tail = entry.data.primaryTag?.split('/').slice(1).join(' / ') ?? '';
---
<Base title={entry.data.title} description={entry.data.description}>
  <div class="wrap post-grid">
    <article>
      <div style="font-size: 13px; color: var(--muted); margin-bottom: 14px; display: flex; gap: 7px; align-items: baseline; flex-wrap: wrap;">
        <a href={`${base}/category/${encodeURIComponent(entry.data.category)}`} style="color: var(--muted);">{entry.data.category}</a>
        {tail && <><span aria-hidden="true" style="color: var(--border);">/</span><span>{tail}</span></>}
      </div>

      <h1 style="font-family: var(--serif); font-size: 30px; font-weight: 600; line-height: 1.4; margin: 0 0 14px; letter-spacing: -0.01em; max-width: var(--measure); text-wrap: pretty;">
        {entry.data.title}
      </h1>

      <div style="display: flex; gap: 14px; align-items: baseline; flex-wrap: wrap; font-size: 13px; color: var(--muted); padding-bottom: 22px; border-bottom: 1px solid var(--border);">
        <time class="num" datetime={date}>{date}</time>
        {count > 0 && (
          <><span aria-hidden="true" style="color: var(--border);">·</span>
          <span>由 <span class="num">{count}</span> 篇笔记整理</span></>
        )}
        {series && (
          <><span aria-hidden="true" style="color: var(--border);">·</span>
          <span>
            <a href={`${base}/series/${encodeURIComponent(series.series.id)}`} style="color: var(--muted);">{series.series.title}</a>
            　第 <span class="num">{series.no}</span> / <span class="num">{series.total}</span> 篇
          </span></>
        )}
      </div>

      <div class:list={['prose', count > 0 && 'numbered']} style="padding-top: 26px;">
        <slot />
      </div>

      <div style="display: grid; gap: 34px; margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--border);">
        {entry.data.references?.length > 0 && (
          <section>
            <h2 class="eyebrow">参考文献</h2>
            <ul style="margin: 0; padding-left: 18px; font-size: 14.5px; color: var(--muted); line-height: 1.85;">
              {entry.data.references.map((r: string) => (
                <li>{/^https?:\/\//.test(r) ? <a href={r}>{r}</a> : r}</li>
              ))}
            </ul>
          </section>
        )}

        {entry.data.tags?.length > 0 && (
          <section>
            <h2 class="eyebrow">标签</h2>
            <div style="display: flex; flex-wrap: wrap; gap: 7px;">
              {entry.data.tags.map((t: string) => (
                <a href={`${base}/tags/${encodeURIComponent(t)}`}
                   style="font-size: 12.5px; color: var(--muted); border: 1px solid var(--border); padding: 3px 9px; border-radius: 3px;">{t}</a>
              ))}
            </div>
          </section>
        )}

        {series && (series.prev || series.next) && (
          <section>
            <h2 class="eyebrow">本系列</h2>
            <div style="display: grid; gap: 10px;">
              {series.prev && (
                <a href={`${base}/posts/${series.prev.post.id}`} style="font-size: 14.5px;">
                  ← 上一篇　{series.prev.title}
                </a>
              )}
              {series.next && (
                <a href={`${base}/posts/${series.next.post.id}`} style="font-size: 14.5px;">
                  下一篇 →　{series.next.title}
                </a>
              )}
            </div>
          </section>
        )}

        {related.length > 0 && (
          <section>
            <h2 class="eyebrow">相关文章</h2>
            <ul style="margin: 0; padding-left: 18px; font-size: 14.5px; line-height: 1.85;">
              {related.map((p: any) => (
                <li><a href={`${base}/posts/${p.id}`}>{p.data.title}</a></li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </article>

    <aside class="toc-rail">
      {toc.length > 1 && (
        <>
          <h2 class="eyebrow" style="font-size: 12px; margin-bottom: 10px;">目录</h2>
          <nav aria-label="本页目录" class:list={[count > 0 && 'numbered']}>
            {toc.map((h) => (
              <a href={`#${h.slug}`} class={h.depth === 3 ? 'd3' : 'd2'}>{h.text}</a>
            ))}
          </nav>
        </>
      )}
    </aside>
  </div>
</Base>

<script>
  // 只有正文里真出现 mermaid 块才去加载它：mermaid 有 2MB 量级，
  // 绝大多数文章一张图都没有，不该为它付流量。动态 import 让打包器
  // 把它切成单独的 chunk，按需下载。
  const nodes = [...document.querySelectorAll('pre.mermaid')];
  if (nodes.length) {
    // 先把源码存起来：渲染后 <pre> 的内容会被 SVG 替换掉，
    // 系统深浅色一换就得拿原文重画
    nodes.forEach((n) => { n.dataset.src = n.textContent ?? ''; });
    const { default: mermaid } = await import('mermaid');
    const media = matchMedia('(prefers-color-scheme: dark)');
    const draw = async () => {
      const forced = document.documentElement.dataset.theme;
      const dark = forced === 'dark' || (forced !== 'light' && media.matches);
      mermaid.initialize({
        startOnLoad: false,
        theme: dark ? 'dark' : 'neutral',
        fontFamily: getComputedStyle(document.body).fontFamily,
      });
      nodes.forEach((n) => {
        n.removeAttribute('data-processed');
        n.textContent = n.dataset.src ?? '';
      });
      await mermaid.run({ nodes });
    };
    await draw();
    media.addEventListener('change', draw);
  }
</script>
